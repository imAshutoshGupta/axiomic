# Copy to .env.local and fill in. Both values are public (safe in the browser).
# Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only (never NEXT_PUBLIC_). See DB-DESIGN section 10.
# Pooler, transaction mode (port 6543), user axiomic_server.<project-ref>:
AXIOMIC_DATABASE_URL=
# Rule encryption keys: {"1":"<base64 of 32 random bytes>"}  (openssl rand -base64 32)
AXIOMIC_RULE_KEYS=
AXIOMIC_RULE_KEY_CURRENT=
